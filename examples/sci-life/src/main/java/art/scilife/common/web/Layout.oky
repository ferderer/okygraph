package art.scilife.common.web;

import org.springframework.security.web.csrf.CsrfToken;

public abstract class Layout extends OkyTemplate {
    /** Hidden CSRF field for Spring Security forms; app helper, not part of the base class (ADR-0117). */
    protected OkyTemplate csrfInput() {
        CsrfToken token = (CsrfToken) request.getAttribute(CsrfToken.class.getName());
        if (token == null) return this;
        html("<input type=\"hidden\" name=\"");
        attr(token.getParameterName());
        html("\" value=\"");
        attr(token.getToken());
        return html("\">");
    }

    public void simpleLayout(Content meta, Content body) {`
        <!doctype html>
        <html lang="de">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <link rel='shortcut icon' type='image/x-icon' href='/_/icons/favicon.png?app=sci-life'>
            {meta}
            <link rel="stylesheet" href="/_/styles.css">
        </head>
        <body>
        <main>
                {body}
            </main>
        </body>
        </html>
    `}

    public void layout(Content meta, Content body) {`
      <!doctype html>
      <html lang="de">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <link rel='shortcut icon' type='image/x-icon' href='/_/icons/favicon.png?app=sci-life'>
          {meta}
          <link rel="stylesheet" href="/_/styles.css">
      </head>
      <body>
        <header>
          <nav>
            <sl-logo>Sci-Life</sl-logo>
            <a href="/food">Lebensmittel</a>
            <a href="/news">News</a>
            <a href="/optimizer">Optimizer</a>
            <a href="/login">Anmelden</a>
            <a href="/register">Registrieren</a>
          </nav>
        </header>
        <main>
          {body}
        </main>
        <footer>
          <p>© 2026 Sci-Life · <a href="/imprint">Impressum</a> · <a href="/privacy">Datenschutz</a></p>
        </footer>
      </body>
      </html>
    `}
}
