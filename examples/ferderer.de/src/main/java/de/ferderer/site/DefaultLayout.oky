package de.ferderer.site;

import com.ibm.icu.number.LocalizedNumberFormatter;
import com.ibm.icu.number.NumberFormatter;
import com.ibm.icu.number.Precision;
import com.ibm.icu.text.MessageFormat;
import com.ibm.icu.util.ULocale;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;
import java.util.ResourceBundle;
import java.util.concurrent.ConcurrentHashMap;
import org.springframework.context.i18n.LocaleContextHolder;

public abstract class DefaultLayout extends OkyTemplate {

    // No fallback to the JVM's default locale: a request for a missing language gets messages.properties.
    private static final ResourceBundle.Control NO_FALLBACK =
        ResourceBundle.Control.getNoFallbackControl(ResourceBundle.Control.FORMAT_PROPERTIES);

    // ICU number formatters are immutable and thread-safe: one per locale and number of decimals, created once.
    private static final Map<String, LocalizedNumberFormatter> NUMBER_FORMATS = new ConcurrentHashMap<>();

    // ICU message formats are not thread-safe: every thread keeps its own parsed patterns.
    private static final ThreadLocal<Map<String, MessageFormat>> MESSAGE_FORMATS = ThreadLocal.withInitial(HashMap::new);

    /**
     * i18n helper (ADR-0091, ADR-0123): looks the key up in messages*.properties for the request locale. Without
     * arguments the text is returned as it is; with arguments it is an ICU message ({0}, plural, date, number).
     */
    protected String t(String key, Object... args) {
        Locale locale = LocaleContextHolder.getLocale();
        String pattern = ResourceBundle.getBundle("messages", locale, NO_FALLBACK).getString(key);
        if (args.length == 0) {
            return pattern;
        }
        return MESSAGE_FORMATS.get().computeIfAbsent(locale + "|" + key, k -> new MessageFormat(pattern, locale)).format(args);
    }

    /** Number with a fixed count of decimals in the request locale (1234.5 gives 1,234.5 or 1.234,5). */
    protected String number(double value, int decimals) {
        Locale locale = LocaleContextHolder.getLocale();
        return NUMBER_FORMATS.computeIfAbsent(locale + "|" + decimals,
            k -> NumberFormatter.withLocale(ULocale.forLocale(locale)).precision(Precision.fixedFraction(decimals))).format(value).toString();
    }

    protected void layout(String title, Content meta, Content body) {`
        <!doctype html>
        <html lang="de">
          <head>
            <title>{title}</title>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <meta name="description" content="">

            {meta}

            <link href="_/icons/favicon-32x32.png" rel="icon" type="image/png" sizes="32x32">
            <link href="_/icons/favicon-16x16.png" rel="icon" type="image/png" sizes="16x16">
            <link href="_/icons/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180">
            <link href="_/site.webmanifest" rel="manifest">
            <link href="_/styles.css" rel="stylesheet">
          </head>
          <body>
            <header>
              <h1>Vadim Ferderer</h1>
              <nav>
                <a href="/" aria-label="{attr(t("nav.home"))}">{t("nav.home")}</a>
                <a href="/blog" aria-label="{attr(t("nav.blog"))}">{t("nav.blog")}</a>
                <a href="/projects" aria-label="{attr(t("nav.projects"))}">{t("nav.projects")}</a>
                <a href="/about" aria-label="{attr(t("nav.about"))}">{t("nav.about")}</a>
              </nav>
            </header>
            <main>
                {body}
            </main>
            <footer>
              <p>© 2024 Vadim Ferderer</p>
            </footer>
          </body>
        </html>
    `}
}
