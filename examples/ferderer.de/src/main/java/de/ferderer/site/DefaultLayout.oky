package de.ferderer.site;

import java.util.ResourceBundle;
import org.springframework.context.i18n.LocaleContextHolder;

public abstract class DefaultLayout extends OkyTemplate {

    // No fallback to the JVM's default locale: a request for a missing language gets messages.properties.
    private static final ResourceBundle.Control NO_FALLBACK =
        ResourceBundle.Control.getNoFallbackControl(ResourceBundle.Control.FORMAT_PROPERTIES);

    /** i18n helper (ADR-0091): looks the key up in messages*.properties for the request locale. */
    protected String t(String key) {
        return ResourceBundle.getBundle("messages", LocaleContextHolder.getLocale(), NO_FALLBACK).getString(key);
    }

    protected void layout(String title, Content meta, Content body) {`
        <!doctype html>
        <html lang="de">
          <head>
            <title>{title}</title>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <meta name="description" content="">

            {meta}

            <link href="_/icons/favicon-32x32.png" rel="icon" type="image/png" sizes="32x32">
            <link href="_/icons/favicon-16x16.png" rel="icon" type="image/png" sizes="16x16">
            <link href="_/icons/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180">
            <link href="_/site.webmanifest" rel="manifest">
            <link href="_/styles.css" rel="stylesheet">
          </head>
          <body>
            <header>
              <h1>Vadim Ferderer</h1>
              <nav>
                <a href="/" aria-label="{t("nav.home")}">{t("nav.home")}</a>
                <a href="/blog" aria-label="{t("nav.blog")}">{t("nav.blog")}</a>
                <a href="/projects" aria-label="{t("nav.projects")}">{t("nav.projects")}</a>
                <a href="/about" aria-label="{t("nav.about")}">{t("nav.about")}</a>
              </nav>
            </header>
            <main>
                {body}
            </main>
            <footer>
              <p>© 2024 Vadim Ferderer</p>
            </footer>
          </body>
        </html>
    `}
}
