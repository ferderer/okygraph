package ${package};

import java.io.IOException;
import java.io.StringWriter;
import java.io.UncheckedIOException;
import java.io.Writer;

/** Base class of all templates, without any framework: a template renders into the Writer it is given. */
public abstract class OkyTemplate {

    /** What an open try block has written so far; it knows the writer to return to and the block around it. */
    private static final class Buffer extends StringWriter {
        final Writer parent;
        final Buffer enclosing;

        Buffer(Writer parent, Buffer enclosing) {
            this.parent = parent;
            this.enclosing = enclosing;
        }
    }

    private Buffer open; // the innermost open try block; most templates have none
    private Writer out;

    /** Renders into the writer as it is: nothing is wrapped, buffered or flushed. */
    public void render(Writer writer) throws Exception {
        open = null;
        out = writer;
        render();
    }

    protected abstract void render() throws Exception;

    // ── Output ───────────────────────────────────────────────────────────────

    /** Raw HTML — no escaping. Used by transpiler for literal template content. */
    public OkyTemplate html(String s) {
        put(s);
        return this;
    }

    /** Expression output — routes to the correct overload by type. */
    public OkyTemplate write(int v)     { put(String.valueOf(v)); return this; }
    public OkyTemplate write(long v)    { put(String.valueOf(v)); return this; }
    public OkyTemplate write(double v)  { put(String.valueOf(v)); return this; }
    public OkyTemplate write(float v)   { put(String.valueOf(v)); return this; }
    public OkyTemplate write(boolean v) { put(String.valueOf(v)); return this; }
    public OkyTemplate write(char v)    { put(String.valueOf(v)); return this; }

    /** String — HTML-escaped. */
    public OkyTemplate write(String s) {
        if (s != null) put(escape(s));
        return this;
    }

    /** Raw — skips escaping. Use raw("...") for trusted HTML fragments. */
    public OkyTemplate write(Raw raw) {
        if (raw != null) put(raw.value());
        return this;
    }

    /** Content slot — renders a lambda into the current output position. */
    public OkyTemplate write(Content content) {
        if (content != null) content.render();
        return this;
    }

    // ── Types ─────────────────────────────────────────────────────────────────

    protected static Raw raw(String s) { return new Raw(s); }

    /** Value inside a quoted HTML attribute: escapes &, <, > and both quote characters. Use {attr(x)} there instead of {x}. */
    protected static Raw attr(String s) {
        return s == null ? null : new Raw(escape(s).replace("\"", "&quot;").replace("'", "&#39;"));
    }

    public record Raw(String value) {}

    @FunctionalInterface
    public interface Content {
        void render();
    }

    // ── Writer stack (try/catch injection) ───────────────────────────────────

    protected void pushBuffer() {
        open = new Buffer(out, open);
        out = open;
    }

    protected void commitBuffer() {
        Buffer buffer = open;
        open = buffer.enclosing;
        out = buffer.parent;
        put(buffer.toString());
    }

    protected void discardBuffer() {
        out = open.parent;
        open = open.enclosing;
    }

    // ── Internal ─────────────────────────────────────────────────────────────

    private void put(String s) {
        try {
            out.write(s);
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
    }

    private static String escape(String s) {
        return s.replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;");
    }
}
