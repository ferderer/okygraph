package ${package};

import java.io.IOException;
import java.io.StringWriter;
import java.io.UncheckedIOException;
import java.io.Writer;

/** Base class of all templates, without any framework: a template renders into the Writer it is given. */
public abstract class OkyTemplate {

    private Writer out;

    /** Renders into the writer as it is: nothing is wrapped, buffered or flushed. */
    public void render(Writer writer) throws Exception {
        out = writer;
        render();
    }

    protected abstract void render() throws Exception;

    // ── Output ───────────────────────────────────────────────────────────────

    /** Raw HTML — no escaping. Used by transpiler for literal template content. */
    public OkyTemplate html(String s) {
        put(s);
        return this;
    }

    /** Expression output — routes to the correct overload by type. */
    public OkyTemplate write(int v)     { put(String.valueOf(v)); return this; }
    public OkyTemplate write(long v)    { put(String.valueOf(v)); return this; }
    public OkyTemplate write(double v)  { put(String.valueOf(v)); return this; }
    public OkyTemplate write(float v)   { put(String.valueOf(v)); return this; }
    public OkyTemplate write(boolean v) { put(String.valueOf(v)); return this; }
    public OkyTemplate write(char v)    { put(String.valueOf(v)); return this; }

    /** String — HTML-escaped (& < >). */
    public OkyTemplate write(String s) {
        if (s != null) escaped(s, false);
        return this;
    }

    /** What raw() and attr() return: they have already written. Only this template is accepted. */
    public OkyTemplate write(OkyTemplate written) {
        if (written != this) {
            throw new IllegalArgumentException("not an output of this template: " + written);
        }
        return this;
    }

    /** Content slot — renders a lambda into the current output position. */
    public OkyTemplate write(Content content) {
        if (content != null) content.render();
        return this;
    }

    // ── Escaping ─────────────────────────────────────────────────────────────

    /** Trusted HTML, written as it is: {raw(x)}. Writes now, so it must be the whole expression. */
    protected OkyTemplate raw(String s) {
        return s == null ? this : html(s);
    }

    /** Value inside a quoted HTML attribute: {attr(x)} escapes & < > " and '. Writes now, so it must be the whole expression. */
    protected OkyTemplate attr(String s) {
        if (s != null) escaped(s, true);
        return this;
    }

    @FunctionalInterface
    public interface Content {
        void render();
    }

    // ── try/catch in templates ───────────────────────────────────────────────

    /** The output of a try block. It reaches the page only if the block commits; close() always restores the writer. */
    protected final class Buffer extends StringWriter {
        private final Writer parent = out;

        private Buffer() {
            out = this;
        }

        public void commit() {
            try {
                parent.write(toString());
            } catch (IOException e) {
                throw new UncheckedIOException(e);
            }
        }

        @Override
        public void close() {
            out = parent;
        }
    }

    protected Buffer buffer() {
        return new Buffer();
    }

    // ── Internal ─────────────────────────────────────────────────────────────

    private void put(String s) {
        try {
            out.write(s);
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
    }

    /** Writes s with & < > (in attributes also " and ') replaced. Strings that need nothing, nearly all of them, are written whole. */
    private void escaped(String s, boolean attribute) {
        if (!clean(s, attribute)) {
            s = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
            if (attribute) {
                s = s.replace("\"", "&quot;").replace("'", "&#39;");
            }
        }
        put(s);
    }

    /** Short strings: one loop. From 64 characters on the JDK's vectorized indexOf is faster (measured). */
    private static boolean clean(String s, boolean attribute) {
        int n = s.length();
        if (n < 64) {
            for (int i = 0; i < n; i++) {
                char c = s.charAt(i);
                if (c == '&' || c == '<' || c == '>' || (attribute && (c == '"' || c == '\''))) {
                    return false;
                }
            }
            return true;
        }
        return s.indexOf('&') < 0 && s.indexOf('<') < 0 && s.indexOf('>') < 0
            && (!attribute || s.indexOf('"') < 0 && s.indexOf('\'') < 0);
    }
}
