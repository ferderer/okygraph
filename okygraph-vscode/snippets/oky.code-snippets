{
  "Template block": {
    "prefix": "oky-block",
    "body": ["`", "\t$1", "`"],
    "description": "Okygraph template block"
  },
  "If block": {
    "prefix": "oky-if",
    "body": [
      "`if ($1) {`",
      "\t$2",
      "`}`"
    ],
    "description": "Okygraph if block"
  },
  "If-else block": {
    "prefix": "oky-ifelse",
    "body": [
      "`if ($1) {`",
      "\t$2",
      "`} else {`",
      "\t$3",
      "`}`"
    ],
    "description": "Okygraph if-else block"
  },
  "For loop": {
    "prefix": "oky-for",
    "body": [
      "`for (var $1 : $2) {`",
      "\t$3",
      "`}`"
    ],
    "description": "Okygraph for-each loop"
  },
  "Try-catch block": {
    "prefix": "oky-try",
    "body": [
      "`try {`",
      "\t$1",
      "`} catch ($2 $3) {`",
      "\t$4",
      "`}`"
    ],
    "description": "Okygraph try-catch block (writer stack injection)"
  },
  "Expression": {
    "prefix": "oky-expr",
    "body": "{$1}",
    "description": "Okygraph expression output"
  }
}
